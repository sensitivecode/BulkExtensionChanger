<Window x:Class="BulkExtensionChanger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Массовая смена расширений"
        Icon="Assets/app.ico"
        Width="860"
        Height="600"
        MinWidth="680"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgWindowBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header + Windows Context Menu Integration Status -->
        <Border Grid.Row="0"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderBrushSubtle}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Массовая смена расширений"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="MenuStatusText"
                               Text="Контекстное меню Windows: проверка..."
                               FontSize="12"
                               Margin="0,2,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="InstallMenuButton"
                            Content="Добавить в контекстное меню"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="InstallMenuButton_Click"
                            Margin="0,0,8,0"/>
                    <Button x:Name="UninstallMenuButton"
                            Content="Удалить из меню"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="UninstallMenuButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Target Extension Dropdown & Options -->
        <Border Grid.Row="1"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderBrushSubtle}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="270"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="Новое расширение (выберите из списка)"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,5"/>
                    <ComboBox x:Name="ExtensionComboBox"
                              Style="{StaticResource DarkComboBoxStyle}"
                              SelectionChanged="ExtensionComboBox_SelectionChanged"/>
                    <Grid x:Name="CustomExtensionPanel" Visibility="Collapsed" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Своё (без точки):"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBox x:Name="CustomExtensionTextBox"
                                 Grid.Column="1"
                                 Height="30"
                                 Padding="8,4"
                                 Background="{StaticResource BgInputBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 CaretBrush="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderBrushSubtle}"
                                 BorderThickness="1"
                                 VerticalContentAlignment="Center"
                                 TextChanged="CustomExtensionTextBox_TextChanged"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="Если файл с таким именем уже есть"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,5"/>
                    <ComboBox x:Name="CollisionComboBox"
                              Style="{StaticResource DarkComboBoxStyle}"
                              SelectionChanged="CollisionComboBox_SelectionChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,12,0,0">
                    <CheckBox x:Name="SelectAllCheckBox"
                              Content="Выбрать все"
                              IsChecked="True"
                              Style="{StaticResource DarkCheckBoxStyle}"
                              Click="SelectAllCheckBox_Click"
                              Margin="0,0,20,0"/>
                    <CheckBox x:Name="IncludeSubfoldersCheckBox"
                              Content="Включая вложенные папки"
                              IsChecked="False"
                              Style="{StaticResource DarkCheckBoxStyle}"
                              Click="IncludeSubfoldersCheckBox_Click"
                              Margin="0,0,20,0"/>
                    <TextBlock Text="Меняется только расширение имени файла (без конвертации)"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- File Preview Table + Empty State -->
        <Border Grid.Row="2"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderBrushSubtle}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="1"
                Margin="0,0,0,12">
            <Grid>
                <ListView x:Name="FilesListView"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SizeChanged="FilesListView_SizeChanged">
                    <ListView.Resources>
                        <Style TargetType="GridViewColumnHeader">
                            <Setter Property="Background" Value="#2A2A30"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSubtle}"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Padding" Value="10,7"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </ListView.Resources>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="#2D2D34"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="Padding" Value="4,5"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2C2C34"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#2A3A4D"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="40">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Click="ItemCheckBox_Click"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ColOldName" Header="Текущее имя" Width="260">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FileName}"
                                                   ToolTip="{Binding OriginalPath}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ColNewName" Header="Новое имя" Width="260">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding NewFileName}"
                                                   ToolTip="{Binding TargetPath}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ColStatus" Header="Статус" Width="220">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUnchanged}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasConflict}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Empty State Overlay -->
                <StackPanel x:Name="EmptyStatePanel"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock Text="Файлы не выбраны"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Перетащите сюда файлы или папки, либо выберите их вручную"
                               FontSize="13"
                               Margin="0,6,0,14"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Выбрать файлы..."
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="AddFilesButton_Click"
                                Margin="0,0,8,0"/>
                        <Button Content="Выбрать папку..."
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="AddFolderButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer Actions -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="SummaryText"
                           Text="Файлов: 0"
                           FontSize="13"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock x:Name="LastActionText"
                           Text=""
                           FontSize="12"
                           Foreground="{StaticResource SuccessBrush}"
                           Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="UndoButton"
                        Content="Отменить последнее"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="UndoButton_Click"
                        IsEnabled="False"
                        Margin="0,0,8,0"/>
                <Button Content="Добавить..."
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="AddFilesButton_Click"
                        Margin="0,0,8,0"/>
                <Button Content="Очистить"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="ClearButton_Click"
                        Margin="0,0,8,0"/>
                <Button x:Name="ApplyButton"
                        Content="Применить"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="ApplyButton_Click"
                        MinWidth="140"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
